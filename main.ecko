# geo - geohashes, great-circle distance, and bounding boxes.
#
#   import geo
#
#   geo.encode(57.64911, 10.40744, 11)     # "u4pruydqqvj"
#   geo.decode("ezs42")                    # { lat: 42.605, lon: -5.603 }
#   geo.km(51.5074, -0.1278, 48.8566, 2.3522)   # 343.5 - London to Paris
#   geo.bbox(51.5074, -0.1278, 5000.0)     # a box 5 km around a point
#
# Everything treats the Earth as a sphere of mean radius 6371008.8 m. That is
# accurate to about 0.5% against the real ellipsoid, which is the right trade
# for "how far apart are these two things"; it is the wrong trade for surveying.
#
# Pure computation - no capabilities.

import std.math

## The IUGG mean Earth radius, in metres.
export fn earth_radius() = 6371008.8

## The geohash alphabet: base 32, with a, i, l and o omitted so the encoding
## cannot produce a character that is easily misread.
export fn alphabet() = "0123456789bcdefghjkmnpqrstuvwxyz"

## The error raised for coordinates or hashes that are not valid.
export fn fail(message) {
    error({ kind: "geo", message: message })
}

## Reject coordinates outside the range the projection is defined on.
export fn check_coords(lat, lon) {
    if lat < -90.0 or lat > 90.0 { fail("latitude {lat} is outside -90..90") }
    if lon < -180.0 or lon > 180.0 { fail("longitude {lon} is outside -180..180") }
}

# --- geohash ------------------------------------------------------------------

## encode(lat, lon, precision) -> a geohash of `precision` characters.
##
## The scheme interleaves longitude and latitude bits, longitude first, and
## packs them five at a time into base 32. Each character therefore narrows the
## box, which is why a shared prefix means spatial proximity - and why a prefix
## match is a usable bounding-box query.
export fn encode(lat, lon, precision) {
    check_coords(lat, lon)
    if precision < 1 { fail("precision must be at least 1") }
    mut lat_lo = -90.0
    mut lat_hi = 90.0
    mut lon_lo = -180.0
    mut lon_hi = 180.0
    mut out = ""
    mut bit = 0
    mut value = 0
    mut even = true
    while len(out) < precision {
        if even {
            mid = (lon_lo + lon_hi) / 2.0
            if lon > mid { value = value * 2 + 1 } else { value = value * 2 }
            if lon > mid { lon_lo = mid } else { lon_hi = mid }
        } else {
            mid = (lat_lo + lat_hi) / 2.0
            if lat > mid { value = value * 2 + 1 } else { value = value * 2 }
            if lat > mid { lat_lo = mid } else { lat_hi = mid }
        }
        even = not even
        bit = bit + 1
        if bit == 5 {
            out = out + chars(alphabet())[value]
            bit = 0
            value = 0
        }
    }
    out
}

## decode_bbox(hash) -> { min_lat, max_lat, min_lon, max_lon }: the cell the
## hash names, rather than a single point. This is the honest answer - a
## geohash is an area, and `decode` only picks its centre.
export fn decode_bbox(hash) {
    if hash == "" { fail("an empty geohash has no cell") }
    mut lat_lo = -90.0
    mut lat_hi = 90.0
    mut lon_lo = -180.0
    mut lon_hi = 180.0
    mut even = true
    for c in chars(hash) {
        idx = index_of(chars(alphabet()), c)
        if idx < 0 { fail("'{c}' is not a geohash character") }
        # Five bits per character, most significant first.
        for shift in [16, 8, 4, 2, 1] {
            on = idx / shift % 2 == 1
            if even {
                mid = (lon_lo + lon_hi) / 2.0
                if on { lon_lo = mid } else { lon_hi = mid }
            } else {
                mid = (lat_lo + lat_hi) / 2.0
                if on { lat_lo = mid } else { lat_hi = mid }
            }
            even = not even
        }
    }
    { min_lat: lat_lo, max_lat: lat_hi, min_lon: lon_lo, max_lon: lon_hi }
}

## decode(hash) -> { lat, lon }: the centre of the cell. Use `decode_bbox` when
## the size of the cell matters, which it usually does.
export fn decode(hash) {
    b = decode_bbox(hash)
    { lat: (b.min_lat + b.max_lat) / 2.0, lon: (b.min_lon + b.max_lon) / 2.0 }
}

# --- distance and bearing ------------------------------------------------------

## The great-circle distance in metres, by the haversine formula.
##
## Haversine rather than the law of cosines because it stays accurate for small
## distances, where the cosine form loses precision to floating point.
export fn distance(lat1, lon1, lat2, lon2) {
    check_coords(lat1, lon1)
    check_coords(lat2, lon2)
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2.0) * math.sin(dp / 2.0) +
        math.cos(p1) * math.cos(p2) * math.sin(dl / 2.0) * math.sin(dl / 2.0)
    # Clamp before asin: rounding can push `a` a hair above 1 for antipodal
    # points, and asin(1.0000000001) is not a number.
    clamped = if a > 1.0 { 1.0 } else { a }
    2.0 * earth_radius() * math.asin(sqrt(clamped))
}

## `distance` in kilometres.
export fn km(lat1, lon1, lat2, lon2) = distance(lat1, lon1, lat2, lon2) / 1000.0

## The initial bearing from the first point to the second, in degrees clockwise
## from north. "Initial" because a great-circle course changes heading as you
## travel it.
export fn bearing(lat1, lon1, lat2, lon2) {
    check_coords(lat1, lon1)
    check_coords(lat2, lon2)
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    degrees = math.degrees(math.atan2(y, x))
    # atan2 gives -180..180; compass bearings are 0..360.
    mod_positive(degrees, 360.0)
}

## `value` wrapped into 0..limit, for a value that may be negative.
export fn mod_positive(value, limit) {
    r = value - limit * float(floor(value / limit))
    if r < 0.0 { r + limit } else { r }
}

## Where you arrive travelling `metres` from a point on a given bearing.
export fn destination(lat, lon, bearing_deg, metres) {
    check_coords(lat, lon)
    d = metres / earth_radius()
    b = math.radians(bearing_deg)
    p1 = math.radians(lat)
    l1 = math.radians(lon)
    p2 = math.asin(math.sin(p1) * math.cos(d) + math.cos(p1) * math.sin(d) * math.cos(b))
    l2 = l1 +
        math.atan2(math.sin(b) * math.sin(d) * math.cos(p1), math.cos(d) - math.sin(p1) * math.sin(p2))
    # Normalise longitude back into -180..180 after crossing the meridian.
    { lat: math.degrees(p2), lon: mod_positive(math.degrees(l2) + 180.0, 360.0) - 180.0 }
}

# --- bounding boxes ------------------------------------------------------------

## A box that contains every point within `metres` of the centre.
##
## The box is a little larger than the circle it brackets - it is the enclosing
## rectangle - so it is a cheap first filter. Follow it with `distance` when
## precision matters.
export fn bbox(lat, lon, metres) {
    check_coords(lat, lon)
    lat_delta = math.degrees(metres / earth_radius())
    # A degree of longitude shrinks with latitude, so the span widens as you
    # approach the poles. Guard the cosine to avoid dividing by zero there.
    cos_lat = math.cos(math.radians(lat))
    lon_delta = if cos_lat < 0.000001 { 180.0 } else { lat_delta / cos_lat }
    {
        min_lat: clamp(lat - lat_delta, -90.0, 90.0),
        max_lat: clamp(lat + lat_delta, -90.0, 90.0),
        min_lon: clamp(lon - lon_delta, -180.0, 180.0),
        max_lon: clamp(lon + lon_delta, -180.0, 180.0),
    }
}

## `value` held within `lo`..`hi`.
export fn clamp(value, lo, hi) {
    if value < lo { return lo }
    if value > hi { return hi }
    value
}

## Is a point inside a box? Edges count as inside.
export fn within(lat, lon, box) {
    lat >= box.min_lat and lat <= box.max_lat and lon >= box.min_lon and lon <= box.max_lon
}

## The centre of a box.
export fn center(box) {
    { lat: (box.min_lat + box.max_lat) / 2.0, lon: (box.min_lon + box.max_lon) / 2.0 }
}

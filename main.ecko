# geo - geohashes, great-circle distance, and bounding boxes.
#
#   import geo
#
#   geo.encode(57.64911, 10.40744, 11)     # "u4pruydqqvj"
#   geo.decode("ezs42")                    # { lat: 42.605, lon: -5.603 }
#   geo.km(51.5074, -0.1278, 48.8566, 2.3522)   # 343.5 - London to Paris
#   geo.bbox(51.5074, -0.1278, 5000.0)     # a box 5 km around a point
#
# Everything treats the Earth as a sphere of mean radius 6371008.8 m. That is
# accurate to about 0.5% against the real ellipsoid, which is the right trade
# for "how far apart are these two things"; it is the wrong trade for surveying.
#
# Pure computation - no capabilities.

import std.math

# The IUGG mean Earth radius, in metres.
fn earth_radius() = 6371008.8

# The geohash alphabet: base 32, with a, i, l and o omitted so the encoding
# cannot produce a character that is easily misread.
fn alphabet() = "0123456789bcdefghjkmnpqrstuvwxyz"

# The longest geohash `encode` makes: 22 characters is 110 bits, already finer
# than a Float coordinate can say.
fn max_precision() = 22

# A world or data failure: a coordinate or hash that is not valid.
fn fail(reason, message) {
    error({ kind: "geo", reason: reason, message: message })
}

# A programmer mistake: an argument of the wrong type or range.
fn bad(message) {
    error({ kind: "bug", reason: "bad_argument", message: message })
}

fn is_num(x) = type_of(x) == "int" or type_of(x) == "float"

fn check_number(who, name, x) {
    unless is_num(x) { bad("geo.{who}: {name} must be a number, got {type_of(x)}") }
}

# Reject coordinates outside the range the projection is defined on.
fn check_coords(who, lat, lon) {
    check_number(who, "latitude", lat)
    check_number(who, "longitude", lon)
    unless lat >= -90.0 and lat <= 90.0 {
        fail("bad_coordinate", "geo.{who}: latitude {lat} is outside -90..90")
    }
    unless lon >= -180.0 and lon <= 180.0 {
        fail("bad_coordinate", "geo.{who}: longitude {lon} is outside -180..180")
    }
}

# Check a box from `bbox` or `decode_bbox`.
fn check_box(who, box) {
    ok = type_of(box) == "map" and
        is_num(get(box, "min_lat")) and
        is_num(get(box, "max_lat")) and
        is_num(get(box, "min_lon")) and
        is_num(get(box, "max_lon"))
    unless ok {
        bad("geo.{who}: box must be a map of numbers min_lat, max_lat, min_lon, max_lon, got {box}")
    }
}

# --- geohash ------------------------------------------------------------------

## Returns the geohash of a point, `precision` characters long (1 to 22).
##
## The scheme interleaves longitude and latitude bits, longitude first, and
## packs them five at a time into base 32. Each character narrows the cell,
## which is why a shared prefix means spatial proximity. A point exactly on a
## cell boundary goes to the lower cell.
##
## errors: `geo`/`bad_coordinate` when a coordinate is out of range;
## `bug`/`bad_argument` when `precision` is not an Int from 1 to 22 or a
## coordinate is not a number.
##
## example:
##   geo.encode(57.64911, 10.40744, 11)   # "u4pruydqqvj"
export fn encode(lat, lon, precision) {
    check_coords("encode", lat, lon)
    unless type_of(precision) == "int" and precision >= 1 and precision <= max_precision() {
        bad("geo.encode: precision must be an int from 1 to {max_precision()}, got {precision}")
    }
    mut lat_lo = -90.0
    mut lat_hi = 90.0
    mut lon_lo = -180.0
    mut lon_hi = 180.0
    mut out = ""
    mut bit = 0
    mut value = 0
    mut even = true
    while len(out) < precision {
        if even {
            mid = (lon_lo + lon_hi) / 2.0
            if lon > mid { value = value * 2 + 1 } else { value = value * 2 }
            if lon > mid { lon_lo = mid } else { lon_hi = mid }
        } else {
            mid = (lat_lo + lat_hi) / 2.0
            if lat > mid { value = value * 2 + 1 } else { value = value * 2 }
            if lat > mid { lat_lo = mid } else { lat_hi = mid }
        }
        even = not even
        bit = bit + 1
        if bit == 5 {
            out = out + chars(alphabet())[value]
            bit = 0
            value = 0
        }
    }
    out
}

## Returns the cell a geohash names, as `{ min_lat, max_lat, min_lon,
## max_lon }`.
##
## This is the honest answer: a geohash is an area, and `decode` only picks its
## centre. Upper-case hashes are accepted.
##
## errors: `geo`/`bad_geohash` when the hash is empty or has a character
## outside the geohash alphabet; `bug`/`bad_argument` when it is not a string.
##
## example:
##   geo.decode_bbox("ezs42").min_lat   # 42.5830078125
export fn decode_bbox(hash) = cell_of("decode_bbox", hash)

fn cell_of(who, hash_in) {
    unless type_of(hash_in) == "string" {
        bad("geo.{who}: hash must be a string, got {type_of(hash_in)}")
    }
    hash = lower(hash_in)
    if hash == "" { fail("bad_geohash", "geo.{who}: an empty geohash has no cell") }
    mut lat_lo = -90.0
    mut lat_hi = 90.0
    mut lon_lo = -180.0
    mut lon_hi = 180.0
    mut even = true
    for c in chars(hash) {
        idx = index_of(chars(alphabet()), c)
        if idx < 0 {
            fail("bad_geohash", "geo.{who}: '{c}' in \"{hash_in}\" is not a geohash character")
        }
        # Five bits per character, most significant first.
        for shift in [16, 8, 4, 2, 1] {
            on = idx // shift % 2 == 1
            if even {
                mid = (lon_lo + lon_hi) / 2.0
                if on { lon_lo = mid } else { lon_hi = mid }
            } else {
                mid = (lat_lo + lat_hi) / 2.0
                if on { lat_lo = mid } else { lat_hi = mid }
            }
            even = not even
        }
    }
    { min_lat: lat_lo, max_lat: lat_hi, min_lon: lon_lo, max_lon: lon_hi }
}

## Returns `{ lat, lon }`, the centre of the cell a geohash names.
##
## Use `decode_bbox` when the size of the cell matters, which it usually does.
## Upper-case hashes are accepted.
##
## errors: `geo`/`bad_geohash` when the hash is empty or has a character
## outside the geohash alphabet; `bug`/`bad_argument` when it is not a string.
##
## example:
##   geo.decode("ezs42")   # {lat: 42.60498046875, lon: -5.60302734375}
export fn decode(hash) {
    b = cell_of("decode", hash)
    { lat: (b.min_lat + b.max_lat) / 2.0, lon: (b.min_lon + b.max_lon) / 2.0 }
}

# --- distance and bearing ------------------------------------------------------

## Returns the great-circle distance between two points in metres, by the
## haversine formula.
##
## Haversine rather than the law of cosines because it stays accurate for small
## distances, where the cosine form loses precision to floating point.
##
## errors: `geo`/`bad_coordinate` when a coordinate is out of range;
## `bug`/`bad_argument` when one is not a number.
##
## example:
##   geo.distance(0.0, 0.0, 0.0, 1.0)   # 111195.0802335329
export fn distance(lat1, lon1, lat2, lon2) = haversine("distance", lat1, lon1, lat2, lon2)

fn haversine(who, lat1, lon1, lat2, lon2) {
    check_coords(who, lat1, lon1)
    check_coords(who, lat2, lon2)
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2.0) * math.sin(dp / 2.0) +
        math.cos(p1) * math.cos(p2) * math.sin(dl / 2.0) * math.sin(dl / 2.0)
    # Clamp before asin: rounding can push `a` a hair above 1 for antipodal
    # points, and asin(1.0000000001) is not a number.
    clamped = if a > 1.0 { 1.0 } else { a }
    2.0 * earth_radius() * math.asin(sqrt(clamped))
}

## Returns the great-circle distance between two points in kilometres.
##
## errors: `geo`/`bad_coordinate` when a coordinate is out of range;
## `bug`/`bad_argument` when one is not a number.
##
## example:
##   geo.km(51.5074, -0.1278, 48.8566, 2.3522)   # 343.55653488088325 - London to Paris
export fn km(lat1, lon1, lat2, lon2) = haversine("km", lat1, lon1, lat2, lon2) / 1000.0

## Returns the initial bearing from the first point to the second, in degrees
## clockwise from north (0 to 360).
##
## "Initial" because a great-circle course changes heading as you travel it.
##
## errors: `geo`/`bad_coordinate` when a coordinate is out of range;
## `bug`/`bad_argument` when one is not a number.
##
## example:
##   geo.bearing(0.0, 0.0, 0.0, 10.0)   # 90
export fn bearing(lat1, lon1, lat2, lon2) {
    check_coords("bearing", lat1, lon1)
    check_coords("bearing", lat2, lon2)
    p1 = math.radians(lat1)
    p2 = math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    degrees = math.degrees(math.atan2(y, x))
    # atan2 gives -180..180; compass bearings are 0..360.
    mod_positive(degrees, 360.0)
}

# `value` wrapped into 0..limit, for a value that may be negative.
fn mod_positive(value, limit) {
    r = value - limit * float(floor(value / limit))
    if r < 0.0 { r + limit } else { r }
}

## Returns `{ lat, lon }`, where you arrive travelling `metres` from a point on
## a bearing in degrees clockwise from north.
##
## errors: `geo`/`bad_coordinate` when a coordinate is out of range;
## `bug`/`bad_argument` when an argument is not a number.
##
## example:
##   geo.destination(51.5074, -0.1278, 90.0, 100000.0)
export fn destination(lat, lon, bearing_deg, metres) {
    check_coords("destination", lat, lon)
    check_number("destination", "bearing", bearing_deg)
    check_number("destination", "metres", metres)
    d = metres / earth_radius()
    b = math.radians(bearing_deg)
    p1 = math.radians(lat)
    l1 = math.radians(lon)
    p2 = math.asin(math.sin(p1) * math.cos(d) + math.cos(p1) * math.sin(d) * math.cos(b))
    l2 = l1 +
        math.atan2(math.sin(b) * math.sin(d) * math.cos(p1), math.cos(d) - math.sin(p1) * math.sin(p2))
    # Normalise longitude back into -180..180 after crossing the meridian.
    { lat: math.degrees(p2), lon: mod_positive(math.degrees(l2) + 180.0, 360.0) - 180.0 }
}

# --- bounding boxes ------------------------------------------------------------

## Returns a box `{ min_lat, max_lat, min_lon, max_lon }` that contains every
## point within `metres` of the centre.
##
## The box encloses the circle, so it includes corners further away than the
## radius: use it as a cheap first filter, then confirm with `distance`. When
## the circle crosses the antimeridian, `min_lon` is greater than `max_lon`
## (the box runs east from `min_lon` across 180 to `max_lon`, as in GeoJSON);
## `within` and `center` understand that. When it reaches a pole, the box
## spans every longitude.
##
## errors: `geo`/`bad_coordinate` when a coordinate is out of range;
## `bug`/`bad_argument` when `metres` is negative or not a number.
##
## example:
##   geo.bbox(51.5074, -0.1278, 5000.0)
export fn bbox(lat, lon, metres) {
    check_coords("bbox", lat, lon)
    check_number("bbox", "metres", metres)
    unless metres >= 0 { bad("geo.bbox: metres must not be negative, got {metres}") }
    r = float(metres) / earth_radius()
    lat_delta = math.degrees(r)
    min_lat = lat - lat_delta
    max_lat = lat + lat_delta
    if min_lat <= -90.0 or max_lat >= 90.0 or r >= math.pi / 2.0 {
        # The circle reaches a pole: every longitude is in reach.
        return {
            min_lat: clamp(min_lat, -90.0, 90.0),
            max_lat: clamp(max_lat, -90.0, 90.0),
            min_lon: -180.0,
            max_lon: 180.0,
        }
    }
    # The widest longitude on a circle of angular radius r around latitude lat
    # is asin(sin r / cos lat); r / cos lat is smaller near the poles and would
    # cut the circle off.
    lon_delta = math.degrees(math.asin(math.sin(r) / math.cos(math.radians(lat))))
    if lon_delta >= 180.0 {
        return { min_lat: min_lat, max_lat: max_lat, min_lon: -180.0, max_lon: 180.0 }
    }
    mut west = lon - lon_delta
    mut east = lon + lon_delta
    if west < -180.0 { west = west + 360.0 }
    if east > 180.0 { east = east - 360.0 }
    { min_lat: min_lat, max_lat: max_lat, min_lon: west, max_lon: east }
}

# `value` held within `lo`..`hi`.
fn clamp(value, lo, hi) {
    if value < lo { return lo }
    if value > hi { return hi }
    value
}

## Returns true when a point is inside a box; edges count as inside.
##
## A box whose `min_lon` is greater than its `max_lon` crosses the
## antimeridian, and is read that way.
##
## errors: `bug`/`bad_argument` when `box` is not a box or a coordinate is not
## a number.
##
## example:
##   geo.within(51.5, -0.12, geo.bbox(51.5074, -0.1278, 5000.0))   # true
export fn within(lat, lon, box) {
    check_box("within", box)
    check_number("within", "latitude", lat)
    check_number("within", "longitude", lon)
    in_lat = lat >= box.min_lat and lat <= box.max_lat
    in_lon = if box.min_lon <= box.max_lon {
        lon >= box.min_lon and lon <= box.max_lon
    } else {
        lon >= box.min_lon or lon <= box.max_lon
    }
    in_lat and in_lon
}

## Returns `{ lat, lon }`, the centre of a box, including one that crosses the
## antimeridian.
##
## errors: `bug`/`bad_argument` when `box` is not a box.
##
## example:
##   geo.center({ min_lat: 0.0, max_lat: 10.0, min_lon: 20.0, max_lon: 30.0 })   # {lat: 5, lon: 25}
export fn center(box) {
    check_box("center", box)
    lat = (box.min_lat + box.max_lat) / 2.0
    if box.min_lon <= box.max_lon { { lat: lat, lon: (box.min_lon + box.max_lon) / 2.0 } } else {
        mid = (box.min_lon + box.max_lon + 360.0) / 2.0
        { lat: lat, lon: if mid > 180.0 { mid - 360.0 } else { mid } }
    }
}

# geo - hashes, distances, and boxes.
#
#   ecko example.ecko

import "./main.ecko" as geo

london = [51.5074, -0.1278]
paris = [48.8566, 2.3522]
cape_town = [-33.9249, 18.4241]

print("geohash:")
for p in [london, paris, cape_town] {
    print("  {p} -> {geo.encode(p[0], p[1], 9)}")
}
print("")

print("a geohash is a box, not a point:")
b = geo.decode_bbox("ezs42")
print("  ezs42 covers lat {b.min_lat}..{b.max_lat}, lon {b.min_lon}..{b.max_lon}")
print("  its centre is {geo.decode(\"ezs42\")}")
print("")

print("shorter hash, bigger box - which is why a shared prefix means 'near':")
for n in [1, 3, 5, 7, 9] {
    h = geo.encode(london[0], london[1], n)
    box = geo.decode_bbox(h)
    span = geo.distance(box.min_lat, box.min_lon, box.max_lat, box.max_lon)
    print("  {h} -> diagonal {round(span / 1000.0 * 100.0) / 100.0} km")
}
print("")

print("distances:")
print("  London to Paris     {round(geo.km(london[0], london[1], paris[0], paris[1]))} km")
print("  London to Cape Town {round(geo.km(london[0], london[1], cape_town[0], cape_town[1]))} km")
print(
    "  bearing to Paris    {round(geo.bearing(london[0], london[1], paris[0], paris[1]))} degrees",
)
print("")

d = geo.destination(london[0], london[1], 90.0, 100000.0)
print(
    "100 km due east of London: {round(d.lat * 10000.0) / 10000.0}, {round(d.lon * 10000.0) / 10000.0}",
)
print("")

print("a 5 km box around London, as a cheap first filter:")
box = geo.bbox(london[0], london[1], 5000.0)
print("  {box}")
for label_point in [["Westminster", 51.4995, -0.1248], ["Greenwich", 51.4826, -0.0077]] {
    inside = geo.within(label_point[1], label_point[2], box)
    away = round(geo.km(london[0], london[1], label_point[1], label_point[2]) * 10.0) / 10.0
    print("  {label_point[0]}: in box {inside}, actually {away} km away")
}
